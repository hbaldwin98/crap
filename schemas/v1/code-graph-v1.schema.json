{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "code-graph-v1.schema.json",
  "$defs": {
    "grammar": {"oneOf": [{"const": {"language": "csharp", "version": "v0.23.5"}}, {"const": {"language": "go", "version": "v0.23.4"}}, {"const": {"language": "typescript", "version": "v0.23.2"}}, {"const": {"language": "tsx", "version": "v0.23.2"}}, {"const": {"language": "rust", "version": "v0.24.0"}}]},
    "coverage": {"type": "object", "required": ["format"], "properties": {"format": {"enum": ["none", "cobertura", "go-coverprofile"]}, "displayedPath": {"type": "string", "minLength": 1}, "sha256": {"$ref": "common.schema.json#/$defs/digest"}}, "additionalProperties": false},
    "discovery": {"type": "object", "required": ["selected", "exclusions"], "properties": {"selected": {"type": "integer", "minimum": 0}, "exclusions": {"type": "array", "items": {"type": "object", "required": ["reason", "count", "examples"], "properties": {"reason": {"enum": ["built-in", "crapignore", "explicit", "generated", "gitignore", "test"]}, "count": {"type": "integer", "minimum": 1}, "examples": {"type": "array", "maxItems": 5, "items": {"$ref": "common.schema.json#/$defs/relativePath"}}}, "additionalProperties": false}}}, "additionalProperties": false},
    "policy": {"type": "object", "required": ["identity", "ownership", "resolution"], "properties": {"identity": {"const": "declaration-occurrence-and-logical-module-v1"}, "ownership": {"const": "nearest-lexical-parent"}, "resolution": {"const": "bounded-selected-source-v1"}}, "additionalProperties": false},
    "summary": {"type": "object", "required": ["files", "modules", "types", "callables", "nodes", "containsEdges", "declaresEdges", "memberOfEdges", "importsEdges", "edges", "references", "resolvedReferences", "unresolvedReferences", "ambiguousReferences", "aboveThreshold"], "properties": {"files": {"type": "integer", "minimum": 0}, "modules": {"type": "integer", "minimum": 0}, "types": {"type": "integer", "minimum": 0}, "callables": {"type": "integer", "minimum": 0}, "nodes": {"type": "integer", "minimum": 0}, "containsEdges": {"type": "integer", "minimum": 0}, "declaresEdges": {"type": "integer", "minimum": 0}, "memberOfEdges": {"type": "integer", "minimum": 0}, "importsEdges": {"type": "integer", "minimum": 0}, "edges": {"type": "integer", "minimum": 0}, "references": {"type": "integer", "minimum": 0}, "resolvedReferences": {"type": "integer", "minimum": 0}, "unresolvedReferences": {"type": "integer", "minimum": 0}, "ambiguousReferences": {"type": "integer", "minimum": 0}, "aboveThreshold": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "location": {"type": "object", "required": ["startLine", "startColumn", "endLine", "endColumn"], "properties": {"startLine": {"type": "integer", "minimum": 1}, "startColumn": {"type": "integer", "minimum": 1}, "endLine": {"type": "integer", "minimum": 1}, "endColumn": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "metrics": {"type": "object", "required": ["complexity", "coveragePercent", "crap", "aboveThreshold"], "properties": {"complexity": {"type": "integer", "minimum": 1}, "coveragePercent": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 100}]}, "crap": {"type": "number", "minimum": 0}, "aboveThreshold": {"type": "boolean"}}, "additionalProperties": false},
    "moduleIdentity": {"type": "object", "required": ["system", "name"], "properties": {"system": {"enum": ["go-package", "ecmascript-file", "csharp-namespace", "rust-module"]}, "name": {"type": "string", "minLength": 1}, "variant": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "moduleMetrics": {"type": "object", "required": ["files", "types", "callables", "complexityTotal", "complexityMaximum", "coverageKnown", "coverageUnknown", "coverageMean", "crapMaximum", "aboveThreshold"], "properties": {"files": {"type": "integer", "minimum": 0}, "types": {"type": "integer", "minimum": 0}, "callables": {"type": "integer", "minimum": 0}, "complexityTotal": {"type": "integer", "minimum": 0}, "complexityMaximum": {"type": "integer", "minimum": 0}, "coverageKnown": {"type": "integer", "minimum": 0}, "coverageUnknown": {"type": "integer", "minimum": 0}, "coverageMean": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 100}]}, "crapMaximum": {"type": "number", "minimum": 0}, "aboveThreshold": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "node": {"type": "object", "required": ["id", "kind", "language", "name", "path", "location", "metrics"], "properties": {"id": {"$ref": "common.schema.json#/$defs/digest"}, "kind": {"enum": ["module", "file", "type", "callable"]}, "language": {"enum": ["csharp", "go", "rust", "typescript"]}, "name": {"type": "string", "minLength": 1}, "path": {"$ref": "common.schema.json#/$defs/relativePath"}, "declarationKind": {"type": "string", "minLength": 1}, "location": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/location"}]}, "metrics": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/metrics"}]}, "module": {"$ref": "#/$defs/moduleIdentity"}, "moduleMetrics": {"$ref": "#/$defs/moduleMetrics"}}, "additionalProperties": false},
    "edge": {"type": "object", "required": ["id", "type", "from", "to", "resolution", "evidence", "occurrences", "references"], "properties": {"id": {"$ref": "common.schema.json#/$defs/digest"}, "type": {"enum": ["contains", "declares", "member-of", "imports"]}, "from": {"$ref": "common.schema.json#/$defs/digest"}, "to": {"$ref": "common.schema.json#/$defs/digest"}, "resolution": {"const": "exact"}, "evidence": {"enum": ["lexical-ast", "module-declaration", "static-import"]}, "occurrences": {"type": "integer", "minimum": 1}, "references": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/digest"}}}, "additionalProperties": false},
    "reference": {"type": "object", "required": ["id", "kind", "language", "sourceFile", "sourceModule", "specifier", "location", "resolution", "candidates"], "properties": {"id": {"$ref": "common.schema.json#/$defs/digest"}, "kind": {"enum": ["go-import", "typescript-import", "typescript-import-type", "typescript-import-require", "typescript-re-export", "typescript-re-export-type", "csharp-using", "csharp-using-static", "csharp-using-alias", "rust-use", "rust-use-glob", "rust-mod"]}, "language": {"enum": ["csharp", "go", "rust", "typescript"]}, "sourceFile": {"$ref": "common.schema.json#/$defs/digest"}, "sourceModule": {"$ref": "common.schema.json#/$defs/digest"}, "specifier": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "binding": {"type": "string", "minLength": 1}, "location": {"$ref": "#/$defs/location"}, "resolution": {"enum": ["resolved", "unresolved", "ambiguous"]}, "target": {"$ref": "common.schema.json#/$defs/digest"}, "candidates": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/digest"}}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "type": "object",
  "required": ["schemaVersion", "reportType", "tool", "fingerprints", "coordinates", "grammars", "coverage", "discovery", "threshold", "policy", "summary", "nodes", "edges", "references", "resolutionInputs", "limitations", "diagnostics"],
  "properties": {
    "schemaVersion": {"const": "1"}, "reportType": {"const": "code-graph"},
    "tool": {"$ref": "common.schema.json#/$defs/tool"}, "fingerprints": {"$ref": "common.schema.json#/$defs/fingerprints"}, "coordinates": {"$ref": "common.schema.json#/$defs/coordinates"},
    "grammars": {"type": "array", "items": {"$ref": "#/$defs/grammar"}}, "coverage": {"$ref": "#/$defs/coverage"}, "discovery": {"$ref": "#/$defs/discovery"},
    "threshold": {"type": "number", "minimum": 0}, "policy": {"$ref": "#/$defs/policy"}, "summary": {"$ref": "#/$defs/summary"},
    "nodes": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/node"}}, "edges": {"type": "array", "maxItems": 250000, "items": {"$ref": "#/$defs/edge"}}, "references": {"type": "array", "maxItems": 250000, "items": {"$ref": "#/$defs/reference"}}, "resolutionInputs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/fileFingerprint"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "diagnostics": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/diagnostic"}}
  },
  "additionalProperties": false
}
