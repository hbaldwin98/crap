{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "mutation-doctor-v1.schema.json",
  "type": "object", "required": ["schemaVersion", "reportType", "tool", "fingerprints", "plan", "ready", "checks"],
  "properties": {
    "schemaVersion": { "const": "1" }, "reportType": { "const": "mutation-doctor" }, "tool": { "$ref": "common.schema.json#/$defs/tool" }, "fingerprints": { "$ref": "common.schema.json#/$defs/fingerprints" },
    "plan": { "$ref": "mutation-plan-v2.schema.json" }, "ready": { "type": "boolean" },
    "checks": { "type": "array", "items": { "type": "object", "required": ["name", "status", "message"], "properties": { "name": { "type": "string", "minLength": 1 }, "status": { "enum": ["passed", "warning", "error"] }, "message": { "type": "string", "minLength": 1 } }, "additionalProperties": false } }
  }, "additionalProperties": false
}
