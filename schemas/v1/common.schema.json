{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string", "minLength": 1, "pattern": "^[^\\\\]+(/[^\\\\]+)*$",
      "not": { "anyOf": [{ "pattern": "^/" }, { "pattern": "^[A-Za-z]:" }, { "pattern": "(^|/)\\.\\.(/|$)" }] }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version", "modified"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "modified": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "coordinates": {
      "type": "object",
      "required": ["lineBase", "columnBase", "columnEncoding", "end"],
      "properties": {
        "lineBase": { "const": 1 },
        "columnBase": { "const": 1 },
        "columnEncoding": { "enum": ["utf-8-bytes", "engine-native"] },
        "end": { "const": "exclusive" }
      },
      "additionalProperties": false
    },
    "fileFingerprint": {
      "type": "object",
      "required": ["sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "fingerprints": {
      "type": "object",
      "required": ["sources", "coverage", "nativeReport", "git", "configSha256"],
      "properties": {
        "sources": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/fileFingerprint" }, { "required": ["path"] }] } },
        "coverage": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fileFingerprint" }] },
        "nativeReport": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fileFingerprint" }] },
        "git": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "baseCommit": { "type": "string", "minLength": 1 },
                "headCommit": { "type": "string", "minLength": 1 },
                "mergeBase": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          ]
        },
        "configSha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["files", "methods", "changedMethods", "aboveThreshold", "averageComplexity", "averageCrap", "maximumCrap"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "methods": { "type": "integer", "minimum": 0 },
        "changedMethods": { "type": "integer", "minimum": 0 },
        "aboveThreshold": { "type": "integer", "minimum": 0 },
        "averageComplexity": { "type": "number", "minimum": 0 },
        "averageCrap": { "type": "number", "minimum": 0 },
        "maximumCrap": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["id", "language", "file", "name", "kind", "signature", "startLine", "startColumn", "endLine", "endColumn", "complexity", "coveragePercent", "crap", "changed", "aboveThreshold"],
      "properties": {
        "id": { "$ref": "#/$defs/digest" },
        "language": { "enum": ["csharp", "go", "typescript"] },
        "file": { "$ref": "#/$defs/relativePath" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 },
        "complexity": { "type": "integer", "minimum": 1 },
        "coveragePercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "crap": { "type": "number", "minimum": 0 },
        "changed": { "type": "boolean" },
        "aboveThreshold": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "candidates": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "mutationSummary": {
      "type": "object",
      "required": ["total", "killed", "survived", "timedOut", "noCoverage", "compileError", "runtimeError", "ignored", "other"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 }, "killed": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 }, "timedOut": { "type": "integer", "minimum": 0 },
        "noCoverage": { "type": "integer", "minimum": 0 }, "compileError": { "type": "integer", "minimum": 0 },
        "runtimeError": { "type": "integer", "minimum": 0 }, "ignored": { "type": "integer", "minimum": 0 },
        "other": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "mutant": {
      "type": "object",
      "required": ["id", "nativeId", "file", "line", "column", "startLine", "startColumn", "endLine", "endColumn", "mutator", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/digest" }, "nativeId": { "type": ["string", "null"] },
        "file": { "$ref": "#/$defs/relativePath" }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 },
        "startLine": { "type": "integer", "minimum": 1 }, "startColumn": { "type": "integer", "minimum": 1 },
        "endLine": { "type": ["integer", "null"], "minimum": 1 }, "endColumn": { "type": ["integer", "null"], "minimum": 1 },
        "mutator": { "type": "string", "minLength": 1 },
        "status": { "enum": ["killed", "survived", "timedOut", "noCoverage", "compileError", "runtimeError", "ignored"] },
        "replacement": { "type": "string" }, "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
