{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-v1.schema.json",
  "$defs": {
    "grammar": { "oneOf": [{ "const": {"language": "csharp", "version": "v0.23.5"} }, { "const": {"language": "go", "version": "v0.23.4"} }, { "const": {"language": "typescript", "version": "v0.23.2"} }, { "const": {"language": "tsx", "version": "v0.23.2"} }, { "const": {"language": "rust", "version": "v0.24.0"} }] },
    "coverage": { "type": "object", "required": ["format"], "properties": { "format": { "enum": ["none", "cobertura", "go-coverprofile"] }, "displayedPath": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "common.schema.json#/$defs/digest" } }, "additionalProperties": false },
    "scopeSummary": { "type": "object", "required": ["changedFiles", "changedCallables", "edges", "truncated", "omittedNodes", "omittedEdges"], "properties": { "changedFiles": { "type": "integer", "minimum": 0 }, "changedCallables": { "type": "integer", "minimum": 0 }, "edges": { "type": "integer", "minimum": 0 }, "truncated": { "type": "boolean" }, "omittedNodes": { "type": "integer", "minimum": 0 }, "omittedEdges": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "comparisonSummary": { "type": "object", "required": ["matched", "added", "removed", "ambiguous", "newRegressions", "complete"], "properties": { "matched": { "type": "integer", "minimum": 0 }, "added": { "type": "integer", "minimum": 0 }, "removed": { "type": "integer", "minimum": 0 }, "ambiguous": { "type": "integer", "minimum": 0 }, "newRegressions": { "type": "integer", "minimum": 0 }, "complete": { "type": "boolean" } }, "additionalProperties": false },
    "graphSummary": { "type": "object", "required": ["files", "modules", "types", "callables", "nodes", "containsEdges", "declaresEdges", "memberOfEdges", "importsEdges", "edges", "references", "resolvedReferences", "unresolvedReferences", "ambiguousReferences", "aboveThreshold"], "properties": { "files": { "type": "integer", "minimum": 0 }, "modules": { "type": "integer", "minimum": 0 }, "types": { "type": "integer", "minimum": 0 }, "callables": { "type": "integer", "minimum": 0 }, "nodes": { "type": "integer", "minimum": 0 }, "containsEdges": { "type": "integer", "minimum": 0 }, "declaresEdges": { "type": "integer", "minimum": 0 }, "memberOfEdges": { "type": "integer", "minimum": 0 }, "importsEdges": { "type": "integer", "minimum": 0 }, "edges": { "type": "integer", "minimum": 0 }, "references": { "type": "integer", "minimum": 0 }, "resolvedReferences": { "type": "integer", "minimum": 0 }, "unresolvedReferences": { "type": "integer", "minimum": 0 }, "ambiguousReferences": { "type": "integer", "minimum": 0 }, "aboveThreshold": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "architectureSummary": { "type": "object", "required": ["modules", "edges", "cycles", "violations", "complete"], "properties": { "modules": { "type": "integer", "minimum": 0 }, "edges": { "type": "integer", "minimum": 0 }, "cycles": { "type": "integer", "minimum": 0 }, "violations": { "type": "integer", "minimum": 0 }, "complete": { "type": "boolean" } }, "additionalProperties": false },
    "callGraphSummary": { "type": "object", "required": ["packages", "functions", "unmatchedCallables", "tests", "edges", "staticEdges", "dispatchEdges", "callSites", "unresolvedCalls", "changedCallables", "affectedTests", "truncatedCallSites", "truncatedUnresolved"], "properties": { "packages": { "type": "integer", "minimum": 0 }, "functions": { "type": "integer", "minimum": 0 }, "unmatchedCallables": { "type": "integer", "minimum": 0 }, "tests": { "type": "integer", "minimum": 0 }, "edges": { "type": "integer", "minimum": 0 }, "staticEdges": { "type": "integer", "minimum": 0 }, "dispatchEdges": { "type": "integer", "minimum": 0 }, "callSites": { "type": "integer", "minimum": 0 }, "unresolvedCalls": { "type": "integer", "minimum": 0 }, "changedCallables": { "type": "integer", "minimum": 0 }, "affectedTests": { "type": "integer", "minimum": 0 }, "truncatedCallSites": { "type": "boolean" }, "truncatedUnresolved": { "type": "boolean" } }, "additionalProperties": false },
    "cycle": { "type": "object", "required": ["modules", "edges"], "properties": { "modules": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/digest" } }, "edges": { "type": "array", "minItems": 1, "items": { "$ref": "architecture-v1.schema.json#/$defs/edgeReference" } } }, "additionalProperties": false },
    "violation": { "type": "object", "required": ["kind", "system", "from", "to", "reason"], "properties": { "kind": { "enum": ["cycle", "forbid"] }, "system": { "oneOf": [{ "const": "" }, { "enum": ["go-package", "ecmascript-file", "csharp-namespace", "rust-module"] }] }, "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 }, "reason": { "type": "string" }, "edges": { "type": "array", "items": { "$ref": "architecture-v1.schema.json#/$defs/edgeReference" } } }, "additionalProperties": false },
    "affectedTest": { "type": "object", "required": ["test", "name", "file", "distance", "seeds"], "properties": { "test": { "$ref": "common.schema.json#/$defs/digest" }, "name": { "type": "string", "minLength": 1 }, "file": { "$ref": "common.schema.json#/$defs/relativePath" }, "distance": { "type": "integer", "minimum": 1 }, "seeds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/digest" } } }, "additionalProperties": false },
    "findingEvidence": { "type": "object", "properties": { "comparisonId": { "$ref": "common.schema.json#/$defs/digest" }, "callableId": { "$ref": "common.schema.json#/$defs/digest" }, "file": { "$ref": "common.schema.json#/$defs/relativePath" }, "name": { "type": "string", "minLength": 1 }, "startLine": { "type": "integer", "minimum": 1 }, "crap": { "type": "number", "minimum": 0 }, "coveragePercent": { "type": "number", "minimum": 0, "maximum": 100 }, "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "test": { "$ref": "common.schema.json#/$defs/digest" }, "testFile": { "$ref": "common.schema.json#/$defs/relativePath" }, "distance": { "type": "integer", "minimum": 1 }, "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 }, "reason": { "type": "string" }, "modules": { "type": "array", "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false },
    "finding": { "type": "object", "required": ["id", "kind", "priority", "severity", "title", "evidence"], "properties": { "id": { "$ref": "common.schema.json#/$defs/digest" }, "kind": { "enum": ["regression", "quality", "coverage", "test-impact", "architecture"] }, "priority": { "type": "integer", "minimum": 1 }, "severity": { "enum": ["error", "warning", "info"] }, "title": { "type": "string", "minLength": 1 }, "evidence": { "$ref": "#/$defs/findingEvidence" } }, "additionalProperties": false },
    "reviewDiagnostic": { "type": "object", "required": ["source", "diagnostic"], "properties": { "source": { "type": "string", "minLength": 1 }, "diagnostic": { "$ref": "common.schema.json#/$defs/diagnostic" } }, "additionalProperties": false }
  },
  "type": "object",
  "required": ["schemaVersion", "reportType", "tool", "coordinates", "grammars", "baseRevision", "baseCommit", "headCommit", "mergeBase", "threshold", "summary", "evidence", "findings", "limitations", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "reportType": { "const": "review" },
    "tool": { "$ref": "common.schema.json#/$defs/tool" },
    "coordinates": { "$ref": "common.schema.json#/$defs/coordinates" },
    "grammars": { "type": "array", "items": { "$ref": "#/$defs/grammar" } },
    "baseRevision": { "type": "string", "minLength": 1 },
    "baseCommit": { "type": "string", "minLength": 1 },
    "headCommit": { "type": "string", "minLength": 1 },
    "mergeBase": { "type": "string", "minLength": 1 },
    "threshold": { "type": "number", "minimum": 0 },
    "summary": { "type": "object", "required": ["changedFiles", "changedCallables", "newRegressions", "qualityFindings", "affectedTests", "architectureViolations", "architectureCycles", "limitations", "diagnostics", "complete"], "properties": { "changedFiles": { "type": "integer", "minimum": 0 }, "changedCallables": { "type": "integer", "minimum": 0 }, "newRegressions": { "type": "integer", "minimum": 0 }, "qualityFindings": { "type": "integer", "minimum": 0 }, "affectedTests": { "type": "integer", "minimum": 0 }, "architectureViolations": { "type": "integer", "minimum": 0 }, "architectureCycles": { "type": "integer", "minimum": 0 }, "limitations": { "type": "integer", "minimum": 0 }, "diagnostics": { "type": "integer", "minimum": 0 }, "complete": { "type": "boolean" } }, "additionalProperties": false },
    "evidence": { "type": "object", "required": ["scope", "quality", "comparison", "regressions", "architecture", "architectureCycles", "architectureViolations", "affectedTests"], "properties": { "scope": { "$ref": "#/$defs/scopeSummary" }, "quality": { "type": "object", "required": ["coverage", "currentGraph", "changedCallables"], "properties": { "coverage": { "$ref": "#/$defs/coverage" }, "currentGraph": { "$ref": "#/$defs/graphSummary" }, "changedCallables": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/method" } } }, "additionalProperties": false }, "comparison": { "$ref": "#/$defs/comparisonSummary" }, "regressions": { "type": "array", "items": { "$ref": "change-scope-comparison-v1.schema.json#/$defs/comparison" } }, "architecture": { "$ref": "#/$defs/architectureSummary" }, "architectureCycles": { "type": "array", "items": { "$ref": "#/$defs/cycle" } }, "architectureViolations": { "type": "array", "items": { "$ref": "#/$defs/violation" } }, "callGraph": { "$ref": "#/$defs/callGraphSummary" }, "affectedTests": { "type": "array", "items": { "$ref": "#/$defs/affectedTest" } } }, "additionalProperties": false },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/reviewDiagnostic" } }
  },
  "additionalProperties": false
}
