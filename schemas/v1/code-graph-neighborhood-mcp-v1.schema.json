{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "code-graph-neighborhood-mcp-v1.schema.json", "type": "object",
  "required": ["pageSchemaVersion", "reportId", "expiresAt", "neighborhood"],
  "properties": {
    "pageSchemaVersion": {"const": "1"}, "reportId": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "expiresAt": {"type": "string", "format": "date-time"},
    "neighborhood": {
      "type": "object", "required": ["schemaVersion", "reportType", "seedNodeIds", "direction", "depth", "edgeTypes", "summary", "nodes", "edges", "references"],
      "properties": {
        "schemaVersion": {"const": "1"}, "reportType": {"const": "code-graph-neighborhood"},
        "seedNodeIds": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "common.schema.json#/$defs/digest"}}, "direction": {"enum": ["incoming", "outgoing", "both"]}, "depth": {"type": "integer", "minimum": 0, "maximum": 5},
        "edgeTypes": {"type": "array", "maxItems": 4, "items": {"enum": ["contains", "declares", "member-of", "imports"]}},
        "summary": {"type": "object", "required": ["seedNodes", "nodes", "edges", "references", "truncated", "omittedNodes", "omittedEdges"], "properties": {"seedNodes": {"type": "integer", "minimum": 1, "maximum": 20}, "nodes": {"type": "integer", "minimum": 1, "maximum": 1000}, "edges": {"type": "integer", "minimum": 0, "maximum": 2000}, "references": {"type": "integer", "minimum": 0, "maximum": 250000}, "truncated": {"type": "boolean"}, "omittedNodes": {"type": "integer", "minimum": 0}, "omittedEdges": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "object", "required": ["node", "distance"], "properties": {"node": {"$ref": "code-graph-v1.schema.json#/$defs/node"}, "distance": {"type": "integer", "minimum": 0, "maximum": 5}}, "additionalProperties": false}},
        "edges": {"type": "array", "maxItems": 2000, "items": {"$ref": "code-graph-v1.schema.json#/$defs/edge"}}, "references": {"type": "array", "maxItems": 250000, "items": {"$ref": "code-graph-v1.schema.json#/$defs/reference"}}
      }, "additionalProperties": false
    }
  }, "additionalProperties": false
}
